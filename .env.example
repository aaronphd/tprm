DATABASE_URL="file:./dev.db"

# Signs login sessions. Required. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: locks the whole app behind /trial-expired once this date passes.
# ISO date, e.g. 2026-09-30. Leave unset for no expiration.
# TRIAL_ENDS_AT=""

# Used once by `npm run create-admin` (and automatically by the Docker
# entrypoint) to create the first login account. No effect once that
# account exists.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""
