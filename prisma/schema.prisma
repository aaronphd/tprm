generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  organizations Organization[]
  assessments   Assessment[]
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  industry      String?
  contactName   String?
  contactEmail  String?
  createdAt     DateTime @default(now())
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdById   String

  assessments Assessment[]
}

model Framework {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  version       String
  description   String
  maturityModel Json

  domains     Domain[]
  assessments Assessment[]
}

model Domain {
  id          String @id @default(cuid())
  framework   Framework @relation(fields: [frameworkId], references: [id])
  frameworkId String
  code        String
  title       String
  sortOrder   Int

  controls Control[]

  @@unique([frameworkId, code])
}

model Control {
  id          String @id @default(cuid())
  domain      Domain @relation(fields: [domainId], references: [id])
  domainId    String
  code        String
  title       String
  description String
  sortOrder   Int

  responses Response[]

  @@unique([domainId, code])
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model Assessment {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String
  framework      Framework        @relation(fields: [frameworkId], references: [id])
  frameworkId    String
  name           String
  status         AssessmentStatus @default(DRAFT)
  targetMaturity Int              @default(3)
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  responses Response[]
}

enum ResponseStatus {
  NOT_IMPLEMENTED
  PARTIAL
  IMPLEMENTED
  NOT_APPLICABLE
}

model Response {
  id           String         @id @default(cuid())
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  control      Control        @relation(fields: [controlId], references: [id])
  controlId    String
  maturity     Int?
  status       ResponseStatus @default(NOT_IMPLEMENTED)
  notes        String?
  updatedAt    DateTime       @updatedAt

  evidence Evidence[]

  @@unique([assessmentId, controlId])
}

model Evidence {
  id         String   @id @default(cuid())
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  responseId String
  title      String
  url        String
  note       String?
  createdAt  DateTime @default(now())
}
