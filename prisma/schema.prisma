// TPRM (Third-Party Risk Management) data model
//
// SQLite has no native enum type, so enum-like fields are stored as
// strings and constrained by TypeScript literal types in src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vendor {
  id             String    @id @default(cuid())
  name           String
  description    String?
  website        String?
  category       String?
  riskTier       String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status         String    @default("PROSPECTIVE") // PROSPECTIVE | ACTIVE | OFFBOARDING | INACTIVE
  ownerName      String?
  contactName    String?
  contactEmail   String?
  contractStart  DateTime?
  contractEnd    DateTime?
  notes          String?
  dataCategories String? // JSON array of sensitive-data-category keys; see src/lib/types.ts DATA_CATEGORIES
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assessments Assessment[]
  findings    Finding[]
  osintScans  OsintScan[]
}

model QuestionnaireTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  questions   QuestionTemplate[]
  assessments Assessment[]
}

model QuestionTemplate {
  id          String                @id @default(cuid())
  templateId  String
  template    QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category    String
  text        String
  weight      Int                   @default(1)
  riskyAnswer String                @default("NO") // YES | NO | PARTIAL | NOT_APPLICABLE
  order       Int                   @default(0)

  responses Response[]

  @@index([templateId])
}

model Assessment {
  id          String                @id @default(cuid())
  vendorId    String
  vendor      Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  templateId  String
  template    QuestionnaireTemplate @relation(fields: [templateId], references: [id])
  title       String
  status      String                @default("DRAFT") // DRAFT | SENT | IN_PROGRESS | COMPLETED
  sentAt      DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  score       Float?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  responses Response[]
  findings  Finding[]

  @@index([vendorId])
}

model Response {
  id                 String           @id @default(cuid())
  assessmentId       String
  assessment         Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionTemplateId String
  questionTemplate   QuestionTemplate @relation(fields: [questionTemplateId], references: [id])
  category           String
  text               String
  weight             Int              @default(1)
  answer             String           @default("UNANSWERED") // YES | NO | PARTIAL | NOT_APPLICABLE | UNANSWERED
  riskFlag           Boolean          @default(false)
  notes              String?
  updatedAt          DateTime         @updatedAt

  findings Finding[]

  @@unique([assessmentId, questionTemplateId])
  @@index([assessmentId])
}

model Finding {
  id           String      @id @default(cuid())
  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  responseId   String?
  response     Response?   @relation(fields: [responseId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  severity     String      @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status       String      @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | ACCEPTED_RISK
  owner        String?
  dueDate      DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([vendorId])
  @@index([assessmentId])
}

// A point-in-time snapshot from the free OSINT toolkit (DNS-over-HTTPS +
// certificate transparency, run server-side; see src/lib/osint). Not
// continuous monitoring -- each row is one scan run on demand.
model OsintScan {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  domain      String
  createdAt   DateTime @default(now())
  resultJson  String // JSON-encoded OsintResult (see src/lib/osint/types.ts)
  manualNotes String? // pasted-back findings from manual deep-link checks

  @@index([vendorId])
}
